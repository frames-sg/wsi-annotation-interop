{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wsi-annotation-interop/raster-profile-v1.schema.json",
  "title": "Pathology raster profile version 1",
  "type": "object",
  "required": [
    "schema_version",
    "input_format",
    "dtype",
    "axes",
    "grid_origin",
    "sample_spacing",
    "coordinate_space",
    "channels",
    "algorithm"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "input_format": {"enum": ["tiff", "npy", "zarr", "tiled-manifest"]},
    "dtype": {
      "enum": [
        "float32",
        "float64",
        "int8",
        "int16",
        "int32",
        "int64",
        "uint8",
        "uint16",
        "uint32",
        "uint64"
      ]
    },
    "axes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["y", "x", "channel"]},
      "allOf": [
        {"contains": {"const": "y"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "x"}, "minContains": 1, "maxContains": 1}
      ]
    },
    "grid_origin": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      },
      "additionalProperties": false
    },
    "sample_spacing": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "exclusiveMinimum": 0},
        "y": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "coordinate_space": {"enum": ["level0-pixels", "source-pixels", "slide-mm"]},
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "quantity", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "quantity": {"$ref": "#/$defs/code"},
          "unit": {"$ref": "#/$defs/code"}
        },
        "additionalProperties": false
      }
    },
    "algorithm": {"$ref": "#/$defs/algorithm"},
    "integer_scaling": {
      "type": "object",
      "required": ["slope", "intercept", "missing_sentinel", "output_precision"],
      "properties": {
        "slope": {"type": "number", "not": {"const": 0}},
        "intercept": {"type": "number"},
        "missing_sentinel": {"type": "integer"},
        "output_precision": {"enum": ["float32", "float64"]}
      },
      "additionalProperties": false
    },
    "zarr_array_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+"}
  },
  "allOf": [
    {
      "if": {"properties": {"coordinate_space": {"const": "slide-mm"}}},
      "then": {"properties": {"grid_origin": {"required": ["z"]}}},
      "else": {"properties": {"grid_origin": {"not": {"required": ["z"]}}}}
    },
    {
      "if": {
        "properties": {"dtype": {"enum": ["float32", "float64"]}},
        "required": ["dtype"]
      },
      "then": {"not": {"required": ["integer_scaling"]}},
      "else": {"required": ["integer_scaling"]}
    },
    {
      "if": {"properties": {"input_format": {"const": "zarr"}}, "required": ["input_format"]},
      "then": {"required": ["zarr_array_path"]},
      "else": {"not": {"required": ["zarr_array_path"]}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "code": {
      "type": "object",
      "required": ["code_meaning"],
      "properties": {
        "code_value": {"type": "string", "minLength": 1},
        "long_code_value": {"type": "string", "minLength": 1},
        "urn_code_value": {"type": "string", "minLength": 1},
        "coding_scheme_designator": {"type": "string", "minLength": 1},
        "coding_scheme_version": {"type": "string", "minLength": 1},
        "code_meaning": {"type": "string", "minLength": 1},
        "context_identifier": {"type": "string", "minLength": 1},
        "context_uid": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*$"},
        "mapping_resource": {"type": "string", "minLength": 1},
        "mapping_resource_uid": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*$"},
        "context_group_version": {"type": "string", "minLength": 1},
        "context_group_local_version": {"type": "string", "minLength": 1},
        "context_group_extension": {"type": "boolean"},
        "context_group_extension_creator_uid": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*$"}
      },
      "oneOf": [
        {
          "required": ["code_value", "coding_scheme_designator"],
          "not": {"anyOf": [{"required": ["long_code_value"]}, {"required": ["urn_code_value"]}]}
        },
        {
          "required": ["long_code_value", "coding_scheme_designator"],
          "not": {"anyOf": [{"required": ["code_value"]}, {"required": ["urn_code_value"]}]}
        },
        {
          "required": ["urn_code_value"],
          "not": {"anyOf": [{"required": ["code_value"]}, {"required": ["long_code_value"]}]}
        }
      ],
      "allOf": [
        {
          "if": {"required": ["coding_scheme_version"]},
          "then": {"required": ["coding_scheme_designator"]}
        },
        {
          "if": {"required": ["context_identifier"]},
          "then": {"required": ["mapping_resource", "context_group_version"]}
        },
        {
          "if": {
            "properties": {"context_group_extension": {"const": true}},
            "required": ["context_group_extension"]
          },
          "then": {
            "required": ["context_identifier", "context_group_local_version", "context_group_extension_creator_uid"]
          }
        }
      ],
      "additionalProperties": false
    },
    "algorithm": {
      "type": "object",
      "required": ["family", "name", "version"],
      "properties": {
        "family": {"$ref": "#/$defs/code"},
        "name_code": {"$ref": "#/$defs/code"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameters": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
