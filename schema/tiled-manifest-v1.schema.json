{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wsi-annotation-interop/tiled-manifest-v1.schema.json",
  "title": "Pathology raster tiled manifest version 1",
  "type": "object",
  "required": ["schema_version", "tiles"],
  "properties": {
    "schema_version": {"const": 1},
    "overlap_policy": {
      "enum": ["reject", "valid-region-crop", "mean", "max", "manifest-order-last-write"]
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/tile"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"overlap_policy": {"const": "valid-region-crop"}},
        "required": ["overlap_policy"]
      },
      "then": {
        "properties": {
          "tiles": {"items": {"required": ["valid_region"]}}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "origin": {
      "type": "object",
      "required": ["y", "x"],
      "properties": {
        "y": {"type": "integer", "minimum": 0},
        "x": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["y", "x", "height", "width"],
      "properties": {
        "y": {"type": "integer", "minimum": 0},
        "x": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "tile": {
      "type": "object",
      "required": ["path", "format", "sample_grid_origin"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+"
        },
        "format": {"enum": ["tiff", "npy"]},
        "sample_grid_origin": {"$ref": "#/$defs/origin"},
        "valid_region": {"$ref": "#/$defs/region"}
      },
      "additionalProperties": false
    }
  }
}
